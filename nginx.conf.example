# Nginx configuration for Solar Heating application
# Place this file in /etc/nginx/conf.d/ or include in your main nginx.conf

upstream solar_heating_backend {
    server 127.0.0.1:8003;
    keepalive 16;
    keepalive_timeout 120s;
    keepalive_requests 10000;
}

server {
    listen 80;
    server_name solar.cdqrmi.com;
    
    # Redirect HTTP to HTTPS
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name solar.cdqrmi.com;

    # SSL configuration (update paths to your certificates)
    ssl_certificate /etc/nginx/ssl/solar.cdqrmi.com.crt;
    ssl_certificate_key /etc/nginx/ssl/solar.cdqrmi.com.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:50m;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/rss+xml application/atom+xml image/svg+xml;

    # Increase buffer sizes for large requests
    client_body_buffer_size 128k;
    client_max_body_size 100m;
    
    # Connection settings
    client_header_timeout 120s;
    client_body_timeout 120s;
    send_timeout 120s;

    # WebSocket endpoint (must be before general location)
    location /ws {
        proxy_pass http://solar_heating_backend;
        proxy_http_version 1.1;
        
        # WebSocket specific settings
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        
        # Long timeout for WebSocket connections
        proxy_connect_timeout 7d;
        proxy_send_timeout 7d;
        proxy_read_timeout 7d;
        
        # Disable buffering for WebSocket
        proxy_buffering off;
    }

    # Proxy settings for Panel/Bokeh application
    location / {
        proxy_pass http://solar_heating_backend;
        proxy_http_version 1.1;

        # Timeout settings
        proxy_connect_timeout 120s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;

        # WebSocket support (required for Panel)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Standard proxy headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Buffer settings
        proxy_buffering off;
        proxy_request_buffering off;

        # Disable caching for dynamic content
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
    }

    # Static files caching (if any)
    location /static/ {
        proxy_pass http://solar_heating_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        
        # Cache static assets
        expires 1d;
        add_header Cache-Control "public, immutable";
    }

    # Health check endpoint
    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    # Access and error logs
    access_log /var/log/nginx/solar_heating_access.log;
    error_log /var/log/nginx/solar_heating_error.log warn;
}

# Map for WebSocket connection upgrade
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
